{
  "$defs": {
    "AttackCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "encounter_id": {
          "title": "Encounter Id",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "expected_version": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "scene_confirmed": {
              "const": true,
              "title": "Scene Confirmed",
              "type": "boolean"
            },
            "target_visible": {
              "const": true,
              "title": "Target Visible",
              "type": "boolean"
            },
            "cover": {
              "const": "none",
              "title": "Cover",
              "type": "string"
            },
            "fixed_dice": {
              "anyOf": [
                {
                  "items": {
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "maxItems": 100,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fixed Dice"
            }
          },
          "required": [
            "scene_confirmed",
            "target_visible",
            "cover"
          ],
          "title": "AttackPayload",
          "type": "object"
        },
        "type": {
          "const": "attack",
          "default": "attack",
          "title": "Type",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "weapon_id": {
          "title": "Weapon Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "encounter_id",
        "actor_id",
        "expected_version",
        "target_id",
        "weapon_id",
        "payload"
      ],
      "title": "AttackCommand",
      "type": "object"
    },
