      "type": "boolean"
    },
    "initiative_confirmed": {
      "const": true,
      "title": "Initiative Confirmed",
      "type": "boolean"
    },
    "distance_convention": {
      "const": "five_ft_chebyshev",
      "title": "Distance Convention",
      "type": "string"
    },
    "notes": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    }
