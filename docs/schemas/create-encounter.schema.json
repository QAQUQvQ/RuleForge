      },
      "title": "Defenses",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "kind": {
          "default": "pc",
          "enum": [
            "pc",
            "npc",
            "monster"
          ],
          "title": "Kind",
          "type": "string"
        },
        "team": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Team",
          "type": "string"
        },
        "initiative": {
          "maximum": 100,
          "minimum": -100,
          "title": "Initiative",
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "defenses": {
          "$ref": "#/$defs/Defenses"
        }
      },
      "required": [
        "character_id",
        "expected_version",
        "team",
        "initiative",
        "position"
      ],
      "title": "Participant",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "maximum": 10000,
          "minimum": -10000,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "maximum": 10000,
          "minimum": -10000,
          "title": "Y",
          "type": "integer"
        }
      },
      "title": "Position",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "participants": {
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "maxItems": 30,
      "minItems": 2,
      "title": "Participants",
      "type": "array"
    },
    "clear_cells": {
