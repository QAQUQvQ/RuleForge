            "body",
            "main_hand",
            "off_hand",
            "inventory"
          ],
          "title": "Equipment Slot",
          "type": "string"
        },
        "relevant_override": {
          "default": null,
          "title": "Relevant Override",
          "type": "null"
        }
      },
      "required": [
        "character_id",
        "equipment_record_id"
      ],
      "title": "EquipmentInstance",
      "type": "object"
    },
    "HitPoints": {
      "additionalProperties": false,
