        },
        "constitution": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Constitution",
          "type": "integer"
        },
        "intelligence": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Intelligence",
          "type": "integer"
        },
        "wisdom": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Wisdom",
          "type": "integer"
        },
        "charisma": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Charisma",
          "type": "integer"
        }
