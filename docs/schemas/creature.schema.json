          "type": "integer"
        },
        "quantity": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "equipped": {
          "default": false,
          "title": "Equipped",
          "type": "boolean"
        },
        "equipment_slot": {
          "default": "inventory",
