          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        },
        "current": {
          "default": 1,
          "maximum": 10000,
          "minimum": 0,
          "title": "Current",
          "type": "integer"
        },
        "temporary": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Temporary",
          "type": "integer"
        }
      },
      "title": "HitPoints",
      "type": "object"
    },
    "VersionedRecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "VersionedRecordRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "ruleset": {
      "const": "srd-5.1",
      "default": "srd-5.1",
      "title": "Ruleset",
      "type": "string"
    },
    "version": {
      "default": 0,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "level": {
      "default": 1,
      "maximum": 20,
      "minimum": 1,
      "title": "Level",
      "type": "integer"
    },
    "abilities": {
      "$ref": "#/$defs/Abilities"
    },
    "equipment": {
      "$ref": "#/$defs/Equipment"
    },
    "hp": {
      "$ref": "#/$defs/HitPoints"
    },
    "speed_ft": {
      "default": 30,
      "maximum": 10000,
      "minimum": 0,
      "title": "Speed Ft",
      "type": "integer"
    },
    "conditions": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Conditions",
      "type": "array"
    },
    "resources": {
      "additionalProperties": {
        "maximum": 10000,
        "minimum": 0,
        "type": "integer"
      },
      "maxProperties": 100,
      "title": "Resources",
      "type": "object"
    },
    "class_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedRecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proficiency_bonus": {
      "default": 2,
      "maximum": 6,
      "minimum": 2,
      "title": "Proficiency Bonus",
      "type": "integer"
    },
    "proficiencies": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Proficiencies",
      "type": "array"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Skills",
      "type": "array"
    },
    "fighting_style": {
      "anyOf": [
        {
          "const": "defense",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fighting Style"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/EquipmentInstance"
      },
      "maxItems": 100,
      "title": "Inventory",
      "type": "array"
    },
    "rule_refs": {
      "items": {
        "$ref": "#/$defs/VersionedRecordRef"
      },
      "maxItems": 100,
      "title": "Rule Refs",
      "type": "array"
    },
    "creation_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creation Scope"
    },
    "kind": {
      "default": "pc",
      "enum": [
        "pc",
        "npc",
        "monster"
      ],
      "title": "Kind",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Creature",
  "type": "object"
}