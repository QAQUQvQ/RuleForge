            "none",
            "leather",
            "light",
            "medium",
            "heavy"
          ],
          "title": "Armor",
          "type": "string"
        },
        "shield": {
          "default": false,
          "title": "Shield",
          "type": "boolean"
        },
        "alternative_ac": {
          "default": false,
          "title": "Alternative Ac",
          "type": "boolean"
        }
      },
      "title": "Equipment",
      "type": "object"
    },
    "EquipmentInstance": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "equipment_record_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Equipment Record Id",
          "type": "string"
        },
        "record_version": {
          "default": 1,
          "minimum": 1,
