          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "ruleset": {
          "const": "srd-5.1",
          "default": "srd-5.1",
          "title": "Ruleset",
          "type": "string"
        },
        "canonical_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "equipment_type": {
          "const": "adventuring_gear",
          "default": "adventuring_gear",
          "title": "Equipment Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weight"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "review_status": {
          "default": "review_required",
          "enum": [
            "review_required",
            "approved",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
