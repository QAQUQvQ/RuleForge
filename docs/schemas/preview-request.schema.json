{
  "$defs": {
    "AttackContext": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "melee",
            "ranged"
          ],
          "title": "Mode",
          "type": "string"
        },
        "distance_ft": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Distance Ft",
          "type": "integer"
        },
        "scene_confirmed": {
          "const": true,
          "title": "Scene Confirmed",
          "type": "boolean"
        },
        "target_visible": {
          "const": true,
          "title": "Target Visible",
          "type": "boolean"
        },
        "cover": {
          "const": "none",
          "title": "Cover",
          "type": "string"
        },
        "hostile_within_5ft": {
          "title": "Hostile Within 5Ft",
          "type": "boolean"
        },
        "advantage": {
          "default": false,
          "title": "Advantage",
          "type": "boolean"
        },
        "disadvantage": {
          "default": false,
          "title": "Disadvantage",
          "type": "boolean"
        },
        "ability": {
          "anyOf": [
            {
              "enum": [
                "strength",
                "dexterity"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ability"
        },
        "special_mechanics": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Special Mechanics",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "distance_ft",
        "scene_confirmed",
        "target_visible",
        "cover",
        "hostile_within_5ft"
      ],
      "title": "AttackContext",
      "type": "object"
    },
    "Defenses": {
      "additionalProperties": false,
      "properties": {
        "resistance": {
          "items": {
            "enum": [
              "acid",
              "bludgeoning",
              "cold",
              "fire",
              "force",
              "lightning",
              "necrotic",
              "piercing",
              "poison",
              "psychic",
              "radiant",
              "slashing",
              "thunder"
            ],
            "type": "string"
          },
          "maxItems": 13,
          "title": "Resistance",
          "type": "array"
        },
        "vulnerability": {
          "items": {
            "enum": [
              "acid",
              "bludgeoning",
              "cold",
              "fire",
              "force",
              "lightning",
              "necrotic",
              "piercing",
              "poison",
              "psychic",
              "radiant",
              "slashing",
              "thunder"
            ],
            "type": "string"
          },
          "maxItems": 13,
          "title": "Vulnerability",
          "type": "array"
        },
        "immunity": {
          "items": {
            "enum": [
              "acid",
              "bludgeoning",
              "cold",
              "fire",
              "force",
              "lightning",
              "necrotic",
              "piercing",
              "poison",
              "psychic",
              "radiant",
              "slashing",
              "thunder"
            ],
            "type": "string"
          },
          "maxItems": 13,
          "title": "Immunity",
          "type": "array"
        }
      },
      "title": "Defenses",
      "type": "object"
    },
    "HitPoints": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Maximum",
          "type": "integer"
        },
        "current": {
          "default": 1,
          "maximum": 10000,
          "minimum": 0,
          "title": "Current",
          "type": "integer"
        },
        "temporary": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Temporary",
          "type": "integer"
        }
      },
      "title": "HitPoints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attacker_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Attacker Id",
      "type": "string"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "weapon_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Weapon Id",
      "type": "string"
    },
    "target_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_ac": {
      "maximum": 100,
      "minimum": 0,
      "title": "Target Ac",
      "type": "integer"
    },
    "target_hp": {
      "$ref": "#/$defs/HitPoints"
    },
    "target_defenses": {
      "$ref": "#/$defs/Defenses"
    },
    "target_scope": {
      "const": "isolated_dm_input",
      "title": "Target Scope",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/AttackContext"
    },
    "fixed_dice": {
      "anyOf": [
        {
          "items": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixed Dice"
    }
  },
  "required": [
    "attacker_id",
    "expected_version",
    "weapon_id",
    "target_id",
    "target_ac",
    "target_hp",
    "target_scope",
    "context"
  ],
  "title": "PreviewRequest",
  "type": "object"
}